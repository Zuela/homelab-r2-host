[Unit]
Description=Prune old r2 secrets snapshots on PBS (datastore r2-configs)
Wants=network-online.target
After=network-online.target homelab-r2-secrets-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/r2-secrets-backup-prune.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
