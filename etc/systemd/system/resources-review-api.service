[Unit]
Description=LIF resources-review API (:8013)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/resources-review
ExecStart=/usr/bin/python3 /usr/local/sbin/resources-review-api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
