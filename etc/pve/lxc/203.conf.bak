arch: amd64
cores: 6
dev0: /dev/nvidia0,gid=44
dev1: /dev/nvidiactl,gid=44
dev2: /dev/nvidia-uvm,gid=44
dev3: /dev/nvidia-uvm-tools,gid=44
features: nesting=1,keyctl=1
hostname: comfyui
memory: 16384
net0: name=eth0,bridge=vmbr0,hwaddr=BC:24:11:01:4E:8F,ip=dhcp,type=veth
onboot: 1
ostype: debian
rootfs: local-lvm:vm-203-disk-0,size=60G
swap: 2048
unprivileged: 1
