#!/bin/bash
# One-time Spotify sign-in for the Demo Tapes raw capture (andr-ops 0053).
# Read-only scopes playlist-read-private and playlist-read-collaborative. Token stays in CT 221, mode 600.
#   From a Mac:   ssh -t -L 8888:192.168.4.68:8888 r2 /usr/local/sbin/andr-spotify-signin
#   From a phone: ssh -t r2 /usr/local/sbin/andr-spotify-signin --paste   (paste the redirected address back)
if [ "${1:-}" = "--paste" ]; then
  exec pct exec 221 -- bash -c "cd /repo/deploy && docker compose --env-file /etc/andr-data/andr-data.env run --rm --no-deps dagster-daemon python -m andr_data.spotify signin --paste"
fi
exec pct exec 221 -- bash -c "cd /repo/deploy && docker compose --env-file /etc/andr-data/andr-data.env run --rm --no-deps -p 8888:8888 dagster-daemon python -m andr_data.spotify signin"
