#!/bin/bash
# andr-live-run (andr-ops 0067). Install: /usr/local/sbin/andr-live-run (root, 0755).
#   andr-live-run NAME.sh        run one approved live script
#   andr-live-run undo LOADID    take a load back out (gtm.undo_load: pending rejected, approved blocked; nothing deleted)
# Rules: the script must be in /etc/andr-live-run/approved with the sha256 Dan approved (andr-live-approve), approved in
# the last 24 hours, and not run before (one shot). No Dagster run in progress. A pg_dump backup first. Every run gets a
# load id (ANDR_LOAD_ID) that the loaders write on each row. Everything is logged to /var/log/andr-live-run.log.
set -euo pipefail
DIR=/etc/andr-live-run; LOG=/var/log/andr-live-run.log; now=$(date -u +%s)
log() { echo "$(date -u +%FT%TZ) $*" >> $LOG; echo "log: $*"; }
psql_live() { pct exec 221 -- docker exec -i andr-data-postgres-1 psql -U postgres -d "$1" -v ON_ERROR_STOP=1 -At; }
busy() { echo "select count(*) from runs where status in ('STARTED','QUEUED','STARTING','CANCELING')" | psql_live dagster; }

if [ "${1:-}" = undo ]; then
  id="${2:-}"
  [[ "$id" =~ ^[a-z0-9_-]{3,80}$ ]] || { echo "usage: andr-live-run undo LOADID" >&2; exit 2; }
  grep -q " load $id\b" $LOG || { echo "unknown load id $id (not in $LOG)" >&2; exit 2; }
  [ "$(busy)" = 0 ] || { echo "A Dagster run is in progress; try again in a few minutes." >&2; exit 4; }
  out=$(echo "SELECT gtm.undo_load('$id', 'dan', 'andr-live-run undo')" | psql_live andr)
  log "UNDO load $id $out"; exit 0
fi

name="${1:-}"
[[ "$name" =~ ^[a-z0-9_-]{1,60}\.sh$ ]] || { echo "usage: andr-live-run NAME.sh | andr-live-run undo LOADID" >&2; exit 2; }
f="$DIR/approved/$name"
[ -f "$f" ] || { echo "not approved: $name" >&2; exit 2; }
line=$(awk -v n="$name" '$2 == n' "$DIR/manifest" | tail -1)
want=$(echo "$line" | cut -d' ' -f1); when=$(echo "$line" | cut -d' ' -f3)
have=$(sha256sum "$f" | cut -d' ' -f1)
if [ -z "$want" ] || [ "$want" != "$have" ]; then log "REFUSED $name sha $have (not the approved checksum)"; exit 3; fi
age=$(( now - $(date -u -d "$when" +%s) ))
if [ "$age" -gt 86400 ]; then log "REFUSED $name approval is older than 24 hours ($when)"; exit 3; fi
if grep -q "START $name sha $have" $LOG; then log "REFUSED $name already ran with this approval (one shot)"; exit 3; fi
[ "$(busy)" = 0 ] || { echo "A Dagster run is in progress; try again in a few minutes." >&2; exit 4; }
id="${name%.sh}-$(date -u +%Y%m%dT%H%M%SZ)"; id=$(echo "$id" | tr 'A-Z_' 'a-z-')
backup=$(pct exec 221 -- bash -c 'F=/backups/andr-pre-live-run-$(date -u +%Y%m%dT%H%M%SZ).dump; docker exec andr-data-postgres-1 pg_dump -U postgres -Fc andr > $F && docker exec -i andr-data-postgres-1 pg_restore --list < $F > /dev/null && echo $F')
log "START $name sha $have load $id backup $backup"
set +e; ANDR_LOAD_ID="$id" bash "$f"; rc=$?; set -e
log "END $name load $id rc $rc"
echo "load id: $id (undo: andr-live-run undo $id)"; exit $rc
