#!/bin/bash
# lab-ip (2026-10-21). LAN address inventory for r2, generated from Proxmox so it never drifts.
#   lab-ip         list CTs/VMs and fixed devices with IP, MAC, mode
#   lab-ip next    next free server IP in 192.168.4.20-.254 for a new CT (static, no eero step)
#   lab-ip plan    rewrite /tank/studio-homelab/ops/IP-PLAN.md
# Addressing (see ops/DECISIONS.md 2026-10-21): 192.168.4.0/22, gw .4.1.
# Servers/CTs: 192.168.4.x and 5.x. eero DHCP pool: 192.168.6.1-7.254 (phones, TVs, guests).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PLAN=/tank/studio-homelab/ops/IP-PLAN.md
# Fixed non-Proxmox devices: "ip|name|mode". Add new ones here.
DEVICES="192.168.4.1|eero gateway|router
192.168.5.10|ProDesk (PBS)|eero reservation
192.168.5.11|r2 Proxmox host|static + eero reservation
192.168.5.124|Camera NVR (Frigate source)|eero reservation
192.168.6.73|Reolink doorbell side door|eero reservation
192.168.6.75|Reolink doorbell front door|eero reservation"

rows() {  # id|name|ip|mac|mode|kind
  for c in $(pct list | awk 'NR>1{print $1}'); do
    cfg=$(pct config "$c")
    name=$(echo "$cfg" | awk '/^hostname:/{print $2}')
    mac=$(echo "$cfg" | grep -o 'hwaddr=[^,]*' | head -1 | cut -d= -f2 | tr A-Z a-z)
    ip=$(echo "$cfg" | grep -o 'ip=[^,]*' | head -1 | cut -d= -f2)
    if [ "$ip" = dhcp ]; then
      mode="DHCP + eero reservation"
      ip=$(pct exec "$c" -- ip -4 -o addr show eth0 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
      [ -z "$ip" ] && ip="(stopped)"
    else
      mode=static; ip=${ip%/*}
    fi
    echo "$c|$name|$ip|$mac|$mode|CT"
  done
  for v in $(qm list 2>/dev/null | awk 'NR>1{print $1}'); do
    cfg=$(qm config "$v")
    name=$(echo "$cfg" | awk '/^name:/{print $2}')
    mac=$(echo "$cfg" | grep -oE '(virtio|e1000|vmxnet3)=[^,]*' | head -1 | cut -d= -f2 | tr A-Z a-z)
    ip=$(echo "$cfg" | grep -o 'ip=[^,/]*' | head -1 | cut -d= -f2); [ -z "$ip" ] && ip="(set in guest)"
    echo "$v|$name|$ip|$mac|see guest|VM"
  done
  echo "$DEVICES" | while IFS='|' read -r ip name mode; do echo "-|$name|$ip|-|$mode|device"; done
}

case "${1:-list}" in
  list) rows | sort -t'|' -k3,3V | column -t -s'|' -N ID,NAME,IP,MAC,MODE,KIND ;;
  next)
    used=$(rows | cut -d'|' -f3)
    for n in $(seq 20 254); do
      ip=192.168.4.$n
      echo "$used" | grep -qx "$ip" && continue
      ping -c1 -W1 -q "$ip" >/dev/null 2>&1 && continue
      ip neigh show "$ip" | grep -q lladdr && continue
      echo "$ip"; exit 0
    done
    echo "no free IP in 192.168.4.20-254" >&2; exit 1 ;;
  plan)
    TS=$(date -u +%FT%TZ)
    { echo "# IP plan (generated by lab-ip plan, $TS, do not hand-edit)"
      echo
      echo "- Subnet 192.168.4.0/22, gateway 192.168.4.1 (eero)."
      echo "- Servers, CTs, VMs and fixed devices: 192.168.4.x and 192.168.5.x."
      echo "- eero DHCP pool: 192.168.6.1 to 192.168.7.254 (phones, TVs, guests). Never put a server there."
      echo "- New CT: run \`lab-ip next\`, set that IP static in Proxmox. No eero step needed."
      echo "- DHCP CTs keep working via eero reservations; new ones should be static instead."
      echo "- Fixed non-Proxmox devices are listed in DEVICES at the top of /usr/local/sbin/lab-ip."
      echo "- Duplicate IPs are alerted by lab-healthcheck (check 6) to ntfy homelab-alerts."
      echo
      echo "| IP | ID | Name | MAC | Mode | Kind |"
      echo "|---|---|---|---|---|---|"
      rows | sort -t'|' -k3,3V | awk -F'|' '{printf "| %s | %s | %s | %s | %s | %s |\n",$3,$1,$2,$4,$5,$6}'
    } > "$PLAN.tmp" && mv "$PLAN.tmp" "$PLAN" && echo "wrote $PLAN" ;;
  *) sed -n '3,6p' "$0"; exit 1 ;;
esac
