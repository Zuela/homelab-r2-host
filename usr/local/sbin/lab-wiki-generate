#!/usr/bin/env python3
"""lab-wiki-generate (2026-11-10, wiki plan). Writes the machine-made pages in the vault's 05 Wiki/Generated/
from the live r2 system, so inventory facts in the wiki can't drift:
  Containers.md     every CT: hostname, IP, state, size, onboot, plus the Role column from ops/ARCHITECTURE.md
  Schedules.md      every active /etc/cron.d job: its header comment and schedule lines
  Host services.md  every enabled custom unit in /etc/systemd/system with its Description
A page is rewritten only when its content changes (the date line is ignored), owned by obsidian so Sync keeps working.
"""
import datetime, glob, os, pwd, re, subprocess

os.environ['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
OUT = '/home/obsidian/vaults/zueyrebro/05 Wiki/Generated'
ARCH = '/tank/studio-homelab/ops/ARCHITECTURE.md'
SYSTEM_CRON = {'e2scrub_all', 'zfsutils-linux', 'vzdump'}
HEAD = ('---\ntype: generated\nstatus: active\n---\n# {title}\n\n'
        '> Generated by `/usr/local/sbin/lab-wiki-generate` on r2 from the live system. Do not edit; it is overwritten. '
        'Canonical doc: `ops/ARCHITECTURE.md`. Wiki: [[index]].\n> Last change: {date}\n\n')


def sh(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout


def cell(s):
    return s.replace('|', '/').replace('\n', ' ').strip()


def containers():
    arch = open(ARCH, encoding='utf-8').read()
    roles = {m.group(1): m.group(2) for m in re.finditer(r'^\|\s*(\d{3})\s*\|[^|]*\|[^|]*\|[^|]*\|\s*([^|]*?)\s*\|\s*$', arch, re.M)}
    rows = ['| CT | Hostname | IP | State | Cores | RAM | Onboot | Role (from ARCHITECTURE.md) |', '|---|---|---|---|---|---|---|---|']
    for line in sh('pct list').splitlines()[1:]:
        ct, status = line.split()[:2]
        cfg = sh(f'pct config {ct}')
        get = lambda k, d='': (re.search(rf'^{k}: (.+)$', cfg, re.M) or [None, d])[1]
        ip = (re.search(r'\bip=([^,\s]+)', cfg) or [None, '?'])[1].split('/')[0]
        if ip == 'dhcp' and status == 'running':
            live = sh(f'pct exec {ct} -- ip -4 -o addr show eth0').split()
            ip = f'{live[3].split("/")[0]} (dhcp)' if len(live) > 3 else 'dhcp'
        rows.append(f'| {ct} | {get("hostname")} | {ip} | {status} | {get("cores", "?")} | {int(get("memory", "0")) // 1024} GB | '
                    f'{"yes" if get("onboot") == "1" else "no"} | {cell(roles.get(ct, "(not in ARCHITECTURE.md)"))} |')
    return '\n'.join(rows) + '\n'


def schedules():
    out = []
    for path in sorted(glob.glob('/etc/cron.d/*')):
        name = os.path.basename(path)
        if '.' in name or name in SYSTEM_CRON:
            continue
        lines = open(path, encoding='utf-8', errors='replace').read().splitlines()
        notes = [l.lstrip('# ').strip() for l in lines if l.startswith('#') and l.strip('# ')]
        jobs = [l for l in lines if l.strip() and not l.startswith('#') and not re.match(r'^[A-Z_]+=', l)]
        out.append(f'## {name}\n\n' + ('\n'.join(notes) + '\n\n' if notes else '') +
                   '```\n' + '\n'.join(jobs) + '\n```\n')
    return '\n'.join(out)


def services():
    rows = ['| Unit | Active | Description |', '|---|---|---|']
    for path in sorted(glob.glob('/etc/systemd/system/*.service') + glob.glob('/etc/systemd/system/*.timer')):
        if os.path.islink(path):
            continue
        unit = os.path.basename(path)
        if sh(f'systemctl is-enabled {unit}').strip() != 'enabled':
            continue
        desc = (re.search(r'^Description=(.+)$', open(path, errors='replace').read(), re.M) or [None, ''])[1]
        rows.append(f'| {unit} | {sh(f"systemctl is-active {unit}").strip()} | {cell(desc)} |')
    return '\n'.join(rows) + '\n'


def write(title, body):
    path = f'{OUT}/{title}.md'
    date = datetime.datetime.now().strftime('%Y-%m-%d %H:%M %Z').strip()
    new = HEAD.format(title=title, date=date) + body
    strip = lambda t: re.sub(r'^> Last change: .*$', '', t, flags=re.M)
    try:
        if strip(open(path, encoding='utf-8').read()) == strip(new):
            return
    except OSError:
        pass
    with open(path, 'w', encoding='utf-8') as f:
        f.write(new)
    pw = pwd.getpwnam('obsidian')
    os.chown(path, pw.pw_uid, pw.pw_gid)
    os.chmod(path, 0o664)
    print('wrote', title)


write('Containers', containers())
write('Schedules', schedules())
write('Host services', services())
