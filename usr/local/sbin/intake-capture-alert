#!/bin/bash
# intake-capture alert (2026-10-29, Dan approved). Runs on the r2 host after the nightly capture window.
# Reads CT218's last intake-capture run and the queue, and sends ONE ntfy message only when something
# needs attention: the run failed, Instagram blocked it, items were held, the run fell back to
# Tesseract, the timer has not run in 26 hours, r2 still owes a scaffold 48 hours old, or a captured
# note has waited on Sage more than 72 hours. Counts and statuses only, never captured text.
# 2026-11-23 (Dan): runs 10:00 ET; body has a "Can wait" section (nothing here is urgent: personal lane).
# 2026-11-28 (Dan): queue counts come from origin/intake-queue after a git fetch (no pull in igcap's
# working repo) via /usr/local/lib/andr/intake_queue_state.py. Captured notes waiting on Sage are their
# own line, not "scaffolds waiting". Every run logs one line (ok or alert); lab-healthcheck warns when
# the log is older than 26.5 hours.
#   --check     print issue lines (r2: or sage:) and exit; no ntfy, no log. Used by lab_health.py weekly.
#   --no-fetch  read origin/intake-queue as last fetched (dry runs).
set -u
CT=218
NTFY_ENV=/root/.creds/ntfy  # defines NTFY_BASE_URL + NTFY_TOKEN_FILE
NTFY_TOPIC=homelab-alerts
LOG=/var/log/intake-capture-alert.log
HELPER=/usr/local/lib/andr/intake_queue_state.py
CHECK=0; NOFETCH=""
for a in "$@"; do
  case "$a" in --check) CHECK=1 ;; --no-fetch) NOFETCH=--no-fetch ;; esac
done
issues=()   # r2's own problems
waiting=()  # Sage's side

result=$(pct exec $CT -- systemctl show intake-capture.service -p Result --value 2>/dev/null)
last=$(pct exec $CT -- systemctl show intake-capture.service -p ExecMainExitTimestampMonotonic --value 2>/dev/null)
up=$(pct exec $CT -- cat /proc/uptime 2>/dev/null | cut -d' ' -f1 | cut -d. -f1)
if [ -z "$result" ]; then
  issues+=("CT$CT unreachable or service missing")
else
  [ "$result" != "success" ] && issues+=("last run result: $result")
  if [ -n "$last" ] && [ "$last" != "0" ] && [ -n "$up" ]; then
    age_h=$(( (up - last / 1000000) / 3600 ))
    [ "$age_h" -gt 26 ] && issues+=("no run in ${age_h}h")
  fi
fi

# Last run's JSON log lines (counts only).
summary=$(pct exec $CT -- journalctl -u intake-capture.service --since "-24h" -o cat --no-pager 2>/dev/null | python3 -c '
import json, sys
held = blocked = 0; vision = None; end = None; errs = 0
for line in sys.stdin:
    try: e = json.loads(line)
    except ValueError: continue
    if e.get("event") == "start": vision = e.get("vision")
    if e.get("status") == "held": held += 1
    if e.get("run") == "ended": blocked += 1
    if e.get("event") == "end": end = e; errs = e.get("vision_errors", 0)
out = []
if blocked: out.append("run stopped by a block (login wall or rate limit)")
if held: out.append(f"{held} item(s) held")
if vision is False: out.append("vision model unavailable, Tesseract only")
if errs: out.append(f"{errs} vision error(s)")
print("; ".join(out))
')
[ -n "$summary" ] && issues+=("$summary")

# Queue: what r2 still owes versus what waits on Sage, from origin/intake-queue.
state=$(pct exec $CT -- su - igcap -s /bin/bash -c "cd ~/work/social-intake && ~/venv/bin/python - $NOFETCH" < "$HELPER" 2>/dev/null)
counts=$(printf '%s' "$state" | python3 -c '
import json, sys
try: s = json.load(sys.stdin)
except ValueError: print("x|queue state unreadable||0|0"); sys.exit()
o, w = s["owed"], s["sage"]
owed = f"{len(o)} scaffold(s) r2 still owes, oldest {o[0][0]}h" if o else ""
sage = f"{len(w)} captured note(s) waiting on Sage, oldest {w[0][0]}h" if w and w[0][0] > 72 else ""
print(("" if s["fetch_ok"] else "git fetch of intake-queue failed, counts from last fetch") + "|" + owed + "|" + sage + f"|{len(o)}|{len(w)}")
')
IFS='|' read -r fetchmsg owedmsg sagemsg n_owed n_sage <<< "$counts"
[ "$fetchmsg" = x ] && { issues+=("$owedmsg"); owedmsg=""; fetchmsg=""; }
[ -n "$fetchmsg" ] && issues+=("$fetchmsg")
[ -n "$owedmsg" ] && issues+=("$owedmsg")
[ -n "$sagemsg" ] && waiting+=("$sagemsg")

if [ "$CHECK" = 1 ]; then
  for i in "${issues[@]+"${issues[@]}"}"; do echo "r2: $i"; done
  for i in "${waiting[@]+"${waiting[@]}"}"; do echo "sage: $i"; done
  exit 0
fi

if [ "${#issues[@]}" -eq 0 ] && [ "${#waiting[@]}" -eq 0 ]; then
  echo "$(date -u +%FT%TZ) ok owed=${n_owed:-?} sage=${n_sage:-?}" >> "$LOG"
  exit 0
fi
msg=$(printf 'Can wait:\n'
      for i in "${issues[@]+"${issues[@]}"}"; do printf -- '- %s\n' "$i"; done
      if [ "${#waiting[@]}" -gt 0 ]; then
        [ "${#issues[@]}" -gt 0 ] && printf '\n'
        printf 'Waiting on Sage (not an r2 problem):\n'; printf -- '- %s\n' "${waiting[@]}"
      fi)
title="intake-capture needs a look"; [ "${#issues[@]}" -eq 0 ] && title="intake-capture: notes waiting on Sage"
echo "$(date -u +%FT%TZ) alert: $(echo "$msg" | tr '\n' '|')" >> "$LOG"
if [ -r "$NTFY_ENV" ]; then
  . "$NTFY_ENV"
  TOKEN=$(cat "$NTFY_TOKEN_FILE" 2>/dev/null)
  curl -fsS -m 10 -H "Authorization: Bearer $TOKEN" -H "Title: $title" -H "Tags: camera" \
    -d "$msg" "$NTFY_BASE_URL/$NTFY_TOPIC" >/dev/null 2>&1 || echo "$(date -u +%FT%TZ) ntfy send FAILED" >> "$LOG"
fi
