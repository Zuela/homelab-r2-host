#!/usr/bin/env python3
"""lab-wiki-lint (2026-11-10, wiki plan). Health check for the vault wiki (05 Wiki). Run by hand for now; not scheduled.

  lab-wiki-lint             local checks only, no model: broken [[links]], pages missing from index.md,
                            missing or incomplete frontmatter, last_reviewed older than 90 days, drafts.
                            Prints the report and writes it to 00 Inbox/Agent Proposals/wiki-lint-<date>.md
  lab-wiki-lint --compile   also asks Claude (claude -p on r2) to review the wiki against ops/ARCHITECTURE.md and
                            ops/DECISIONS.md and write proposals. Only 05 Wiki/ and ops/ are sent: never other
                            vault folders (privacy rule in 05 Wiki/WIKI.md). Proposals land in 00 Inbox/Agent Proposals/.
  --dry-run                 with --compile: print what would be sent, call nothing.
"""
import datetime, glob, os, pwd, re, subprocess, sys

VAULT = '/home/obsidian/vaults/zueyrebro'
WIKI = f'{VAULT}/05 Wiki'
PROPOSALS = f'{VAULT}/00 Inbox/Agent Proposals'
OPS = ['/tank/studio-homelab/ops/ARCHITECTURE.md', '/tank/studio-homelab/ops/DECISIONS.md']
STALE_DAYS = 90
TODAY = datetime.date.today()


def pages():
    return sorted(p for p in glob.glob(f'{WIKI}/**/*.md', recursive=True))


def all_note_names():
    return {os.path.splitext(os.path.basename(p))[0] for p in glob.glob(f'{VAULT}/**/*.md', recursive=True)}


def frontmatter(text):
    m = re.match(r'^---\n(.*?)\n---\n', text, re.S)
    return dict(re.findall(r'^(\w+):\s*(.*)$', m.group(1), re.M)) if m else None


def lint():
    names = all_note_names()
    index = open(f'{WIKI}/index.md', encoding='utf-8').read()
    out = {'broken links': [], 'not in index': [], 'frontmatter': [], 'stale': [], 'drafts': []}
    for p in pages():
        rel = os.path.relpath(p, WIKI)
        name = os.path.splitext(os.path.basename(p))[0]
        text = open(p, encoding='utf-8').read()
        prose = re.sub(r'`[^`\n]*`', '', re.sub(r'```.*?```', '', text, flags=re.S))  # examples in code don't count
        for link in re.findall(r'\[\[([^\]|#]+)', prose):
            if link.strip() not in names:
                out['broken links'].append(f'{rel}: [[{link}]]')
        fm = frontmatter(text)
        meta = rel in ('WIKI.md', 'index.md', 'log.md')
        if not meta and f'[[{name}]]' not in index:
            out['not in index'].append(rel)
        if fm is None:
            out['frontmatter'].append(f'{rel}: no frontmatter')
            continue
        if fm.get('type') in ('meta', 'generated'):
            continue
        for key in ('type', 'status', 'sources', 'last_reviewed'):
            if key not in fm:
                out['frontmatter'].append(f'{rel}: missing {key}')
        try:
            age = (TODAY - datetime.date.fromisoformat(fm.get('last_reviewed', ''))).days
            if age > STALE_DAYS:
                out['stale'].append(f'{rel}: last reviewed {age} days ago')
        except ValueError:
            pass
        if fm.get('status') == 'draft':
            out['drafts'].append(rel)
    return out


def report(out):
    lines = [f'# Wiki lint {TODAY}', '', 'Generated by `lab-wiki-lint` on r2. Delete this note once handled.', '']
    for k, v in out.items():
        lines.append(f'## {k} ({len(v)})')
        lines += [f'- {x}' for x in v] or ['- none']
        lines.append('')
    return '\n'.join(lines)


def save(name, text):
    path = f'{PROPOSALS}/{name}'
    with open(path, 'w', encoding='utf-8') as f:
        f.write(text)
    pw = pwd.getpwnam('obsidian')
    os.chown(path, pw.pw_uid, pw.pw_gid)
    os.chmod(path, 0o664)
    return path


def compile_pass(dry):
    files = [p for p in pages() if '/Generated/' not in p] + OPS
    prompt = (
        'You maintain a homelab wiki. Conventions are in "05 Wiki/WIKI.md" below. Compare the wiki pages with the '
        'canonical ops docs (ARCHITECTURE.md, DECISIONS.md). Output one markdown document of proposals: for each, the '
        'page to create or change, why (cite the ops line or decision date), and the proposed text. Flag contradictions '
        'and stale claims. Do not invent facts that are not in the inputs. No secrets.\n\n'
        + '\n\n'.join(f'===== {os.path.relpath(p, VAULT) if p.startswith(VAULT) else p} =====\n'
                      + open(p, encoding='utf-8').read() for p in files))
    print(f'compile: {len(files)} files, {len(prompt)} chars:')
    for p in files:
        print('  ', p)
    if dry:
        return
    res = subprocess.run(['claude', '-p', '--output-format', 'text'], input=prompt, text=True, capture_output=True, timeout=1800)
    if res.returncode != 0:
        sys.exit(f'claude failed: {res.stderr[-500:]}')
    print('wrote', save(f'wiki-compile-{TODAY}.md', f'# Wiki compile proposals {TODAY}\n\nFrom `lab-wiki-lint --compile` (Claude). Accept by applying to the pages; delete when done.\n\n' + res.stdout))


if __name__ == '__main__':
    out = lint()
    text = report(out)
    print(text)
    if '--dry-run' not in sys.argv:
        print('wrote', save(f'wiki-lint-{TODAY}.md', text))
    if '--compile' in sys.argv:
        compile_pass('--dry-run' in sys.argv)
