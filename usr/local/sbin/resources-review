#!/usr/bin/env python3
"""CLI: resources-review queue|show|approve|deny|notify|migrate"""
from __future__ import annotations
import json, sys
sys.path.insert(0, "/usr/local/sbin")
import resources_review_lib as rr

def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in {"-h", "--help", "help"}:
        print("usage: resources-review queue|show <id>|approve <id>|deny <id> [reason]|notify [--force]|migrate")
        return 0
    cmd = argv[1]
    if cmd == "migrate":
        d = rr.migrate_ledger()
        print(json.dumps({"ok": True, "entries": len(d.get("entries", {}))}))
        return 0
    if cmd == "queue":
        print(json.dumps(rr.queue(), indent=2))
        return 0
    if cmd == "show" and len(argv) >= 3:
        print(json.dumps(rr.show(argv[2]), indent=2))
        return 0
    if cmd == "approve" and len(argv) >= 3:
        print(json.dumps(rr.approve(argv[2], by="cli"), indent=2))
        return 0
    if cmd == "deny" and len(argv) >= 3:
        reason = " ".join(argv[3:]) if len(argv) > 3 else ""
        print(json.dumps(rr.deny(argv[2], reason=reason, by="cli"), indent=2))
        return 0
    if cmd == "notify":
        force = "--force" in argv or "-f" in argv
        # reuse api helper via import
        import importlib.util
        spec = importlib.util.spec_from_file_location("rra", "/usr/local/sbin/resources-review-api.py")
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        if len(argv) >= 3 and not argv[2].startswith("-"):
            data = rr.migrate_ledger()
            sha, entry = rr.find_by_id(data, argv[2])
            if not entry:
                print(json.dumps({"ok": False, "error": "not_found"}))
                return 1
            print(json.dumps(mod.notify_entry(entry), indent=2))
        else:
            print(json.dumps(mod.notify_pending(limit=20, force=force), indent=2))
        return 0
    print("bad args", file=sys.stderr)
    return 2

if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
